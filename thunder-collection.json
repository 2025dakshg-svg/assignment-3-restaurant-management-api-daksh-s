{
  "info": {
    "name": "Restaurant Management API",
    "description": "Assignment 3 - Complete API Collection"
  },
  "item": [
    {
      "name": "1. Welcome",
      "request": {
        "method": "GET",
        "url": "http://localhost:5001/",
        "header": []
      }
    },
    {
      "name": "2. Register User",
      "request": {
        "method": "POST",
        "url": "http://localhost:5001/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"daksh\",\n  \"email\": \"daksh@gmail.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "3. Login User",
      "request": {
        "method": "POST",
        "url": "http://localhost:5001/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"daksh@gmail.com\",\n  \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "4. Get All Restaurants",
      "request": {
        "method": "GET",
        "url": "http://localhost:5001/restaurants",
        "header": []
      }
    },
    {
      "name": "5. Get Restaurant by ID",
      "request": {
        "method": "GET",
        "url": "http://localhost:5001/restaurants/{{restaurantId}}",
        "header": []
      }
    },
    {
      "name": "6. Top 5 Restaurants",
      "request": {
        "method": "GET",
        "url": "http://localhost:5001/restaurants/top",
        "header": []
      }
    },
    {
      "name": "7. Create Restaurant",
      "request": {
        "method": "POST",
        "url": "http://localhost:5001/restaurants",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Spice Garden\",\n  \"city\": \"Mumbai\",\n  \"address\": \"Mulund West\",\n  \"cuisine\": \"Indian\",\n  \"rating\": 4.5\n}"
        }
      }
    },
    {
      "name": "8. Update Restaurant",
      "request": {
        "method": "PUT",
        "url": "http://localhost:5001/restaurants/{{restaurantId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Spice Garden Updated\",\n  \"city\": \"Mumbai\",\n  \"address\": \"Mulund West\",\n  \"cuisine\": \"Indian\",\n  \"rating\": 4.7\n}"
        }
      }
    },
    {
      "name": "9. Delete Restaurant",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:5001/restaurants/{{restaurantId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    },
    {
      "name": "10. Add Menu Item",
      "request": {
        "method": "POST",
        "url": "http://localhost:5001/restaurants/{{restaurantId}}/menu",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Paneer Tikka\",\n  \"price\": 250,\n  \"isAvailable\": true\n}"
        }
      }
    },
    {
      "name": "11. Get Restaurant Menu",
      "request": {
        "method": "GET",
        "url": "http://localhost:5001/restaurants/{{restaurantId}}/menu",
        "header": []
      }
    },
    {
      "name": "12. Update Menu Item",
      "request": {
        "method": "PUT",
        "url": "http://localhost:5001/menu/{{menuItemId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Paneer Tikka Masala\",\n  \"price\": 280,\n  \"isAvailable\": true\n}"
        }
      }
    },
    {
      "name": "13. Delete Menu Item",
      "request": {
        "method": "DELETE",
        "url": "http://localhost:5001/menu/{{menuItemId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ]
      }
    }
  ]
}
